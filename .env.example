# Modèle du fichier .env de production, à recopier sur le serveur sous le nom .env
# (puis chmod 600 ; .env est dans le .gitignore et ne doit jamais être commité).
# Seules ces quatre variables sont lues par compose.prod.yaml : l'URL de la base,
# le compte applicatif, le profil et le chemin de stockage y sont déjà fixés.

# Super-utilisateur du conteneur PostgreSQL. Générer avec : openssl rand -base64 24
POSTGRES_PASSWORD=

# Mot de passe du compte applicatif "dqanalyzer". Autre sortie de : openssl rand -base64 24
# Lu une première fois par db/init/01-create-database.sh : à choisir AVANT le premier démarrage.
DQ_DB_PASSWORD=

# Relais SMTP pour les codes 2FA : la messagerie CNAM-CI, elle aussi portée par
# le certificat wildcard *.ipscnam.ci. Rien à changer.
# Si un jour tu visais un relais installé sur le serveur lui-même, ce ne serait pas
# "localhost" : depuis un conteneur, localhost désigne le conteneur. Ce serait
# host.containers.internal.
DQ_MAIL_HOST=mail.ipscnam.ci
DQ_MAIL_PORT=25
